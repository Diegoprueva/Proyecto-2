
import bpy
import math

# ==========================================
# ZOOLOGICO NICOLAS BRAVO
# MODULO 02 - SUPERFICIES
# ==========================================

COLLECTION_NAME = "02_SUPERFICIES"
BASE_OBJECT_NAME = "BASE_ZOOLOGICO_NICOLAS_BRAVO"

# Separación de la superficie respecto a la cara superior del terreno.
SURFACE_LIFT = 0.02

# ------------------------------------------
# FUNCION PARA CREAR MATERIALES
# ------------------------------------------

def create_material(name, color, roughness=0.85):

    mat = bpy.data.materials.get(name)

    if mat is None:
        mat = bpy.data.materials.new(name)

    mat.diffuse_color = (*color, 1)

    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")

    if bsdf:
        bsdf.inputs["Base Color"].default_value = (*color, 1)
        bsdf.inputs["Roughness"].default_value = roughness

    return mat


def get_explanada(base):
    coords = list(base.get("explanada", []))
    if len(coords) < 6 or len(coords) % 2:
        raise RuntimeError("El terreno no contiene una propiedad 'explanada' válida. Ejecuta 01 primero.")

    points = [(float(coords[i]), float(coords[i + 1])) for i in range(0, len(coords), 2)]
    area = sum(points[i][0] * points[(i + 1) % len(points)][1] -
               points[(i + 1) % len(points)][0] * points[i][1]
               for i in range(len(points))) / 2.0
    if not math.isfinite(area) or abs(area) < 1e-6:
        raise RuntimeError("La explanada del terreno tiene un área inválida.")
    if area < 0:
        points.reverse()

    top_z = max((base.matrix_world @ vertex.co).z for vertex in base.data.vertices)
    return points, top_z + SURFACE_LIFT


# ------------------------------------------
# MATERIALES
# ------------------------------------------

concrete = create_material(
    "Material_Concreto",
    (0.48, 0.46, 0.42)
)

soil = create_material(
    "Material_Tierra",
    (0.27, 0.17, 0.09)
)

grass = create_material(
    "Material_Pasto",
    (0.13, 0.29, 0.08)
)


# ------------------------------------------
# FUNCION PARA CREAR SUPERFICIES
# ------------------------------------------

def create_surface(name, points, material, height):

    vertices = [
        (x, y, height)
        for x, y in points
    ]

    faces = [tuple(range(len(vertices)))]

    mesh = bpy.data.meshes.new(name + "_Mesh")
    mesh.from_pydata(vertices, [], faces)
    mesh.materials.append(material)
    mesh.update()

    obj = bpy.data.objects.new(name, mesh)
    collection.objects.link(obj)

    solidify = obj.modifiers.new(
        "Grosor_Superficie", "SOLIDIFY"
    )
    solidify.thickness = 0.025

    return obj


base = bpy.data.objects.get(BASE_OBJECT_NAME)
if base is None or base.type != 'MESH':
    raise RuntimeError("Falta el terreno de 01. Ejecuta 01_base_terreno.py antes de este módulo.")

plaza, surface_height = get_explanada(base)

# Validar el terreno antes de reemplazar la colección existente.
old = bpy.data.collections.get(COLLECTION_NAME)
if old:
    for obj in list(old.objects):
        bpy.data.objects.remove(obj, do_unlink=True)
    bpy.data.collections.remove(old)

collection = bpy.data.collections.new(COLLECTION_NAME)
bpy.context.scene.collection.children.link(collection)

create_surface(
    "SUPERFICIE_EXPLANADA_PRINCIPAL",
    plaza,
    concrete,
    surface_height
)


print("MODULO 02 - SUPERFICIES CREADO")
